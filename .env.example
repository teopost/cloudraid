# Copia in .env e chmod 600 .env

# Indirizzo LAN del server: l'interfaccia web risponde su https://<LAN_IP>/cloudraid/
LAN_IP=192.168.1.12

# Facoltativo: un nome per l'interfaccia (serve un record DNS o una riga nel file hosts che lo risolva)
# CLOUDRAID_HOST=cloudraid.esempio.it

# Facoltativo: password del repository per la riga di comando non interattiva (cron) e per il mount.
# Il servizio web non la usa: si accede dalla pagina.
# CLOUDRAID_PASSWORD=

# Facoltativo: il repository come cartella in sola lettura sull'host (servizio "mount").
# Richiede CLOUDRAID_PASSWORD qui sopra, perché all'avvio nessuno può digitarla.
# COMPOSE_PROFILES=mount
# Cartella dell'host (il repository compare nella sottocartella archivio/) e proprietario dei file
# CLOUDRAID_MOUNT_DIR=/mnt/cloudraid
# CLOUDRAID_MOUNT_UID=1000
# CLOUDRAID_MOUNT_GID=1000
