# Copia in .env e chmod 600 .env

# Indirizzo LAN del server: l'interfaccia web risponde su https://<LAN_IP>/cloudraid/
LAN_IP=192.168.1.12

# Facoltativo: un nome per l'interfaccia (serve un record DNS o una riga nel file hosts che lo risolva)
# CLOUDRAID_HOST=cloudraid.esempio.it

# Facoltativo: password del repository per la riga di comando non interattiva (cron).
# Il servizio web non la usa: si accede dalla pagina.
# CLOUDRAID_PASSWORD=
